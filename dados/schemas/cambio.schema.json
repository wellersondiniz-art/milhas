{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cambio.schema.json",
  "title": "Câmbio",
  "description": "Cotação usada para converter pontos por dólar dos cartões em pontos por real. O usuário pode trocar a cotação na tela.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "moeda", "reais_por_dolar", "origem", "data_referencia", "observacoes", "fonte_url", "verificado_em"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "moeda": { "enum": ["USD"] },
      "reais_por_dolar": {
        "description": "Quantos reais vale 1 dólar, × 10.000 (53456 = R$ 5,3456). Inteiro, para não usar float.",
        "anyOf": [
          { "type": "integer", "minimum": 1 },
          { "$ref": "#/$defs/a_confirmar" }
        ]
      },
      "origem": {
        "description": "ptax = PTAX de venda do Banco Central.",
        "enum": ["ptax"]
      },
      "data_referencia": {
        "description": "Dia da cotação (AAAA-MM-DD).",
        "anyOf": [{ "$ref": "#/$defs/data" }, { "$ref": "#/$defs/a_confirmar" }]
      },
      "observacoes": { "type": "string" },
      "fonte_url": { "$ref": "#/$defs/url" },
      "verificado_em": { "$ref": "#/$defs/data" }
    }
  },
  "$defs": {
    "id": {
      "description": "Letras minúsculas, números e hífen (ex.: usd-brl).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "data": { "type": "string", "format": "date" },
    "a_confirmar": { "const": "A_CONFIRMAR" }
  }
}
