{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redes-postos.schema.json",
  "title": "Redes de postos de combustível",
  "description": "Redes (bandeiras) de postos. Só a rede: nada de posto individual, endereço ou preço de combustível.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nome", "site", "fonte_url", "verificado_em"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "nome": { "description": "Nome da bandeira como aparece no posto (ex.: Shell).", "type": "string", "minLength": 1 },
      "outros_nomes": {
        "description": "Outros nomes pelos quais a rede é conhecida (ex.: BR para os postos Petrobras). Ajudam a busca.",
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "site": { "description": "Site oficial da rede.", "anyOf": [{ "$ref": "#/$defs/url" }, { "$ref": "#/$defs/a_confirmar" }] },
      "fonte_url": { "$ref": "#/$defs/url" },
      "verificado_em": { "$ref": "#/$defs/data" },
      "observacoes": { "type": "string" }
    }
  },
  "$defs": {
    "id": {
      "description": "Letras minúsculas, números e hífen.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "data": { "type": "string", "format": "date" },
    "a_confirmar": { "const": "A_CONFIRMAR" }
  }
}
