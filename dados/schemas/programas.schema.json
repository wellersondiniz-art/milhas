{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "programas.schema.json",
  "title": "Programas de fidelidade",
  "description": "Lista de programas de fidelidade (milhas, pontos ou cashback).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "nome",
      "tipo",
      "valor_milheiro_brl",
      "url",
      "fonte_url",
      "verificado_em"
    ],
    "properties": {
      "id": {
        "$ref": "#/$defs/id"
      },
      "nome": {
        "type": "string",
        "minLength": 1
      },
      "tipo": {
        "anyOf": [
          {
            "enum": [
              "milhas",
              "pontos",
              "cashback"
            ]
          },
          {
            "$ref": "#/$defs/a_confirmar"
          }
        ]
      },
      "valor_milheiro_brl": {
        "description": "Quanto valem 1.000 pontos, em CENTAVOS inteiros (2000 = R$ 20,00). O usuário poderá editar.",
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "$ref": "#/$defs/a_confirmar"
          }
        ]
      },
      "valor_milheiro_origem": {
        "description": "De onde vem o valor do milheiro. \"estimativa_editavel\" = valor provisório, que o usuário pode trocar na tela. Obrigatório quando valor_milheiro_brl é um número.",
        "enum": [
          "estimativa_editavel",
          "confirmado"
        ]
      },
      "valor_milheiro_fonte_url": {
        "description": "Link da fonte do valor do milheiro. Obrigatório quando valor_milheiro_brl é um número.",
        "$ref": "#/$defs/url"
      },
      "url": {
        "description": "Site do programa.",
        "anyOf": [
          {
            "$ref": "#/$defs/url"
          },
          {
            "$ref": "#/$defs/a_confirmar"
          }
        ]
      },
      "fonte_url": {
        "$ref": "#/$defs/url"
      },
      "verificado_em": {
        "$ref": "#/$defs/data"
      },
      "validade_pontos": {
        "description": "Quanto tempo os pontos valem, pela regra geral publicada pelo programa. Fatos curtos, com a fonte; o prazo de cada pessoa está no extrato do programa.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meses",
          "resumo",
          "fonte_url",
          "verificado_em"
        ],
        "properties": {
          "meses": {
            "description": "Prazo padrão em meses, contado do acúmulo. \"nao_expira\" e \"depende_do_cartao\" quando o programa diz isso; A_CONFIRMAR quando não achamos.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "enum": [
                  "nao_expira",
                  "depende_do_cartao"
                ]
              },
              {
                "$ref": "#/$defs/a_confirmar"
              }
            ]
          },
          "resumo": {
            "description": "A regra em uma ou duas frases, com as palavras do site (não copiar texto da fonte).",
            "type": "string",
            "minLength": 1
          },
          "como_prorrogar": {
            "description": "O que o programa oferece para não perder os pontos (se houver).",
            "type": "string",
            "minLength": 1
          },
          "como_prorrogar_fonte_url": {
            "$ref": "#/$defs/url"
          },
          "fonte_url": {
            "$ref": "#/$defs/url"
          },
          "verificado_em": {
            "$ref": "#/$defs/data"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Letras minúsculas, números e hífen (ex.: azul-fidelidade).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "a_confirmar": {
      "const": "A_CONFIRMAR"
    }
  }
}
