.dev.vars
.wrangler/

# Planilhas e documentos (dados de origem ficam fora do repo)
*.xls
*.xlsx
*.xlsm
*.ods
*.csv
*.pdf
*.doc
*.docx

# Dependências e build
node_modules/
# dist/ é a pasta publicada, gerada por npm run build (scripts/publicar/montar-dist.js)
dist/
build/
.cache/
coverage/

# Logs e temporários
*.log
npm-debug.log*
*.tmp
*.bak
*.swp

# Sistema e editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Cópia gerada dos dados para o site (npm run dados)
site/dados/

# Páginas geradas a partir dos dados (npm run paginas)
site/loja/
site/ofertas/
site/sitemap.xml
site/robots.txt
# Páginas institucionais (scripts/paginas/institucionais.js)
site/como-funciona/
site/sobre-os-dados/
site/privacidade/
site/termos/
site/contato/

# Service worker gerado a partir de scripts/pwa/sw-modelo.js (npm run sw)
site/sw.js
testes/navegador/resultados/
testes/navegador/relatorio/

# Coleta semanal de ofertas (scripts/coletar.js): texto bruto das páginas,
# respostas do modelo e relatórios. Fica só no seu computador.
coleta/

# Painel semanal das métricas (npm run painel): fica só no seu computador.
/painel/
# Extensão montada por npm run extensao (scripts/extensao/montar.js)
extensao/pacote/
testes/extensao/pacote/
testes/extensao/resultados/
testes/extensao/relatorio/
